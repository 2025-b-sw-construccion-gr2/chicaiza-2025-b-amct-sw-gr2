{
  "name": "sistema-recetas-nodejs",
  "version": "1.0.0",
  "description": "Sistema de Recetas Umami - El Quinto Sabor (Node.js + Express)",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "lint": "eslint src/",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "jest --coverage",
    "build": "echo 'Build completado' && mkdir -p dist && cp -r src/* dist/"
  },
  "keywords": [
    "recetas",
    "umami",
    "spoonacular",
    "nodejs",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "mysql2": "^3.6.5",
    "sequelize": "^6.35.2"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.2.0"
  },
  "jest": {
    "coverageReporters": ["text", "lcov", "html"]
  }
}
