<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --blanco: #FFFFFF;
            --negro: #121212;
            --verde: #2D5A27;
            --verde-claro: #E8F5E9;
            --cafe: #4B3621;
            --crema: #F9F7F2;
            --gris: #757575;
            --transicion: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--crema);
            color: var(--negro);
            line-height: 1.6;
        }

        /* --- PANTALLA DE CARGA --- */
        #loader {
            position: fixed;
            inset: 0;
            background: var(--blanco);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            animation: fadeOut 0.5s ease 2s forwards;
        }

        .spinner {
            width: 40px;
            height: 40px;
            border: 2px solid var(--crema);
            border-top: 2px solid var(--cafe);
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        /* --- HEADER --- */
        nav {
            padding: 1.5rem 10%;
            background: var(--blanco);
            border-bottom: 1px solid var(--negro);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            text-decoration: none;
            color: var(--negro);
            font-size: 1.5rem;
        }

        .nav-link {
            text-decoration: none;
            color: var(--negro);
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: var(--transicion);
        }

        .nav-link:hover {
            color: var(--verde);
        }

        header.results-header {
            text-align: center;
            padding: 4rem 10%;
        }

        h1 {
            font-family: 'Playfair Display', serif;
            font-size: 2.5rem;
            color: var(--cafe);
        }

        .header-subtitle {
            text-transform: uppercase;
            letter-spacing: 3px;
            font-size: 0.7rem;
            color: var(--verde);
            margin-top: 10px;
        }

        /* --- INGREDIENTES SELECCIONADOS --- */
        .ingredientes-usados {
            text-align: center;
            padding: 0 2rem 2rem;
            max-width: 800px;
            margin: 0 auto;
        }

        .ingredientes-usados p {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 1rem;
            color: var(--cafe);
            font-weight: 600;
        }

        .ingrediente-tag {
            display: inline-block;
            background: var(--verde);
            color: var(--blanco);
            padding: 0.4rem 0.8rem;
            margin: 0.2rem;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* --- GRID DE RESULTADOS --- */
        .recipe-container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 2rem 5rem;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 30px;
        }

        .recipe-card {
            background: var(--blanco);
            border: 1px solid var(--negro);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            opacity: 0;
            animation: fadeInUp 0.8s ease forwards;
        }

        .recipe-card:nth-child(1) { animation-delay: 2.3s; }
        .recipe-card:nth-child(2) { animation-delay: 2.5s; }
        .recipe-card:nth-child(3) { animation-delay: 2.7s; }
        .recipe-card:nth-child(4) { animation-delay: 2.9s; }
        .recipe-card:nth-child(5) { animation-delay: 3.1s; }
        .recipe-card:nth-child(6) { animation-delay: 3.3s; }
        .recipe-card:nth-child(7) { animation-delay: 3.5s; }
        .recipe-card:nth-child(8) { animation-delay: 3.7s; }
        .recipe-card:nth-child(9) { animation-delay: 3.9s; }
        .recipe-card:nth-child(10) { animation-delay: 4.1s; }

        .recipe-image {
            width: 100%;
            height: 200px;
            background-color: var(--negro);
            position: relative;
            overflow: hidden;
        }

        .recipe-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0.9;
        }

        /* --- CONTADORES E INDICADORES --- */
        .match-badge {
            position: absolute;
            top: 15px;
            right: 15px;
            background: var(--verde);
            color: var(--blanco);
            padding: 5px 12px;
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 1px;
        }

        .match-badge.medium {
            background: var(--cafe);
        }

        .match-badge.low {
            background: var(--gris);
        }

        .recipe-content {
            padding: 1.5rem;
            flex-grow: 1;
        }

        .recipe-content h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1.4rem;
            margin-bottom: 1rem;
            line-height: 1.3;
        }

        /* Barra de progreso de ingredientes */
        .progress-container { margin-bottom: 1.5rem; }
        .progress-text {
            display: flex;
            justify-content: space-between;
            font-size: 0.75rem;
            margin-bottom: 5px;
            text-transform: uppercase;
            font-weight: 600;
        }
        .progress-bar {
            height: 4px;
            background: #eee;
            width: 100%;
        }
        .progress-fill {
            height: 100%;
            background: var(--verde);
            transition: width 1s ease-out 2.5s;
        }

        /* Listado de ingredientes dinámico */
        .ingredient-analysis {
            font-size: 0.85rem;
            border-top: 1px solid #eee;
            padding-top: 1rem;
        }

        .ing-label {
            font-weight: 600;
            font-size: 0.7rem;
            text-transform: uppercase;
            margin-bottom: 5px;
        }

        .ing-label.missing {
            margin: 10px 0 5px;
            color: var(--cafe);
        }

        .ing-list { list-style: none; margin-top: 5px; }

        .ing-item {
            display: flex;
            align-items: center;
            margin-bottom: 5px;
        }

        .ing-item.have { color: var(--verde); font-weight: 600; }
        .ing-item.miss { color: var(--gris); }

        .ing-item::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            margin-right: 10px;
            display: inline-block;
        }

        .ing-item.have::before { background: var(--verde); }
        .ing-item.miss::before { background: #ccc; }

        .btn-view {
            margin-top: auto;
            background: var(--negro);
            color: var(--blanco);
            text-align: center;
            padding: 1rem;
            text-decoration: none;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 2px;
            transition: var(--transicion);
            display: block;
        }

        .btn-view:hover { background: var(--cafe); }

        /* --- SIN RECETAS --- */
        .no-recetas {
            text-align: center;
            padding: 6rem 2rem;
            background: var(--blanco);
            border: 1px solid var(--negro);
            max-width: 600px;
            margin: 0 auto;
            opacity: 0;
            animation: fadeInUp 0.8s ease 2.3s forwards;
        }

        .no-recetas h2 {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            color: var(--cafe);
            margin-bottom: 1rem;
        }

        .no-recetas p {
            color: var(--negro);
            opacity: 0.7;
            margin-bottom: 0.5rem;
        }

        .emoji-grande {
            font-size: 4rem;
            margin-bottom: 1.5rem;
        }

        .btn-volver {
            display: inline-block;
            background: var(--negro);
            color: var(--blanco);
            padding: 1rem 2.5rem;
            text-decoration: none;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 600;
            font-size: 0.8rem;
            transition: var(--transicion);
            margin-top: 1.5rem;
        }

        .btn-volver:hover {
            background: var(--verde);
        }

        /* --- FOOTER --- */
        footer {
            padding: 6rem 2rem;
            text-align: center;
            background: var(--negro);
            color: var(--blanco);
            letter-spacing: 3px;
            font-size: 0.7rem;
            text-transform: uppercase;
        }

        /* --- ANIMACIONES --- */
        @keyframes spin { to { transform: rotate(360deg); } }
        @keyframes fadeOut { to { opacity: 0; visibility: hidden; } }
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

        @media (max-width: 600px) { .recipe-container { grid-template-columns: 1fr; } }
    </style>
</head>
<body>

    <div id="loader">
        <div class="spinner"></div>
        <p style="margin-top: 15px; letter-spacing: 3px; font-size: 0.6rem; text-transform: uppercase;">Analizando tu despensa...</p>
    </div>

    <nav>
        <a href="/" class="logo">UMAMI</a>
        <a href="/ingredientes" class="nav-link">&larr; Nueva Búsqueda</a>
    </nav>

    <header class="results-header">
        <h1>Análisis Culinario</h1>
        <p class="header-subtitle">Resultados basados en tu inventario</p>
    </header>

    <% if (ingredientesSeleccionados && ingredientesSeleccionados.length > 0) { %>
        <div class="ingredientes-usados">
            <p>Tu selección de ingredientes</p>
            <% for (const ingrediente of ingredientesSeleccionados) { %>
                <span class="ingrediente-tag"><%= ingrediente %></span>
            <% } %>
        </div>
    <% } %>

    <main class="recipe-container">
        <% if (recetas && recetas.length > 0) { %>
            <% for (const receta of recetas) { %>
                <%
                    const totalIngredients = receta.usedIngredientCount + receta.missedIngredientCount;
                    const matchPercent = totalIngredients > 0 ? Math.round((receta.usedIngredientCount * 100.0) / totalIngredients) : 0;
                    let badgeClass = '';
                    if (matchPercent < 50) badgeClass = 'low';
                    else if (matchPercent < 80) badgeClass = 'medium';
                %>
                <article class="recipe-card">
                    <div class="recipe-image">
                        <span class="match-badge <%= badgeClass %>">
                            <% if (matchPercent === 100) { %>
                                100% Completa
                            <% } else { %>
                                <%= matchPercent %>% Match
                            <% } %>
                        </span>
                        <img src="<%= receta.image %>"
                             alt="<%= receta.title %>"
                             onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?q=80&w=600&auto=format&fit=crop'">
                    </div>
                    <div class="recipe-content">
                        <h3><%= receta.titleEs %></h3>

                        <div class="progress-container">
                            <div class="progress-text">
                                <span>Ingredientes</span>
                                <span><%= receta.usedIngredientCount %> de <%= totalIngredients %> usados</span>
                            </div>
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: <%= matchPercent %>%;"></div>
                            </div>
                        </div>

                        <div class="ingredient-analysis">
                            <p class="ing-label">Tienes:</p>
                            <ul class="ing-list">
                                <% if (receta.usedIngredients) { %>
                                    <% for (const ing of receta.usedIngredients) { %>
                                        <li class="ing-item have"><%= ing.nameEs %></li>
                                    <% } %>
                                <% } %>
                            </ul>

                            <% if (receta.missedIngredientCount > 0 && receta.missedIngredients) { %>
                                <p class="ing-label missing">Te falta:</p>
                                <ul class="ing-list">
                                    <% for (const ing of receta.missedIngredients) { %>
                                        <li class="ing-item miss"><%= ing.nameEs %></li>
                                    <% } %>
                                </ul>
                            <% } %>
                        </div>
                    </div>
                    <a href="/receta?id=<%= receta.id %>" class="btn-view">Ver Preparación</a>
                </article>
            <% } %>
        <% } else { %>
            <div class="no-recetas" style="grid-column: 1 / -1;">
                <div class="emoji-grande">🍽️</div>
                <h2>Sin Resultados</h2>
                <p>No encontramos recetas con esos ingredientes.</p>
                <p>Intenta seleccionar otros ingredientes.</p>
                <a href="/ingredientes" class="btn-volver">
                    ← Volver a la Despensa
                </a>
            </div>
        <% } %>
    </main>

    <% if (recetas && recetas.length > 0) { %>
        <footer>
            &copy; 2026 Recetas Umami &mdash; La Alquimia del Gusto
        </footer>
    <% } %>

</body>
</html>
